{
  "uid": "alghrest-pnl-v1",
  "title": "ALGHREST — Portfolio PnL",
  "tags": ["alghrest", "trading"],
  "timezone": "UTC",
  "refresh": "5s",
  "time": { "from": "now-1d", "to": "now" },
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Cumulative PnL",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 16, "h": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#4ade80" },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "alghrest_portfolio_cumulative_pnl_usd",
          "legendFormat": "Cumulative PnL"
        }
      ]
    },
    {
      "id": 2,
      "title": "Daily PnL",
      "type": "barchart",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "alghrest_portfolio_daily_pnl_usd",
          "legendFormat": "Daily PnL"
        }
      ]
    },
    {
      "id": 3,
      "title": "Drawdown",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 7 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#ef4444" },
          "custom": { "fillOpacity": 25, "lineWidth": 2 },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 25 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "alghrest_portfolio_drawdown_pct",
          "legendFormat": "Drawdown %"
        }
      ],
      "options": {
        "tooltip": { "mode": "single" },
        "thresholdLines": [{ "label": "Kill Switch", "y": 25, "color": "#ef4444" }]
      }
    },
    {
      "id": 4,
      "title": "Sharpe Ratio",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 8, "w": 4, "h": 7 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": -2,
          "max": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 1.5 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "alghrest_portfolio_sharpe_ratio",
          "legendFormat": "Sharpe"
        }
      ]
    },
    {
      "id": 5,
      "title": "Win Rate",
      "type": "stat",
      "gridPos": { "x": 16, "y": 8, "w": 4, "h": 7 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 45 },
              { "color": "green", "value": 55 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "alghrest_portfolio_win_rate_pct",
          "legendFormat": "Win Rate"
        }
      ]
    },
    {
      "id": 6,
      "title": "Profit Factor",
      "type": "stat",
      "gridPos": { "x": 20, "y": 8, "w": 4, "h": 7 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1.0 },
              { "color": "green", "value": 1.5 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "alghrest_portfolio_profit_factor",
          "legendFormat": "Profit Factor"
        }
      ]
    }
  ]
}
