# =============================================================================
# ALGHREST — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# ─────────────────────────────────────────────────────
# SYSTEM
# ─────────────────────────────────────────────────────
ENVIRONMENT=development          # development | paper_trading | live
OPERATING_PROFILE=general        # general | earn2trade_tcp25 (advisory only)
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
SYSTEM_CAPITAL_USD=10000         # Starting capital in USD

# ─────────────────────────────────────────────────────
# 🚨 DeFi SAFETY OVERRIDE 🚨
# CRITICAL: Tier 6 DeFi agents contain MOCK LOGIC and are HIGH RISK!
# Only enable after implementing proper protocol integrations.
# ─────────────────────────────────────────────────────
ENABLE_DEFI_AGENTS=false         # Force disable DeFi agents for safety

# ─────────────────────────────────────────────────────
# AI / LLM — Anthropic Claude
# CIO uses Opus (reasoning), others use Sonnet (analysis)
# ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────
# EXCHANGE APIs — START WITH PAPER TRADING
# ─────────────────────────────────────────────────────

# Binance (start with testnet)
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=true
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# Bybit (testnet available)
BYBIT_API_KEY=
BYBIT_SECRET=
BYBIT_TESTNET=true

# Coinbase Advanced Trade
COINBASE_API_KEY=
COINBASE_SECRET=

# Kraken
KRAKEN_API_KEY=
KRAKEN_SECRET=

# Alpaca (US Equities) — ALWAYS start with paper
ALPACA_API_KEY=
ALPACA_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Interactive Brokers
IBKR_HOST=127.0.0.1
IBKR_PORT=7497            # 7497=paper, 7496=live
IBKR_CLIENT_ID=1

# OKX
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# Deribit (Options)
DERIBIT_API_KEY=
DERIBIT_SECRET=
DERIBIT_TESTNET=true

# ─────────────────────────────────────────────────────
# MARKET DATA PROVIDERS
# ─────────────────────────────────────────────────────

# Glassnode (on-chain analytics)
GLASSNODE_API_KEY=

# Nansen (wallet intelligence)
NANSEN_API_KEY=

# Federal Reserve (FRED API)
FRED_API_KEY=

# Twitter/X API v2
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Reddit API (PRAW)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ALGHREST/1.0

# Dune Analytics
DUNE_API_KEY=

# CoinGecko (free tier available)
COINGECKO_API_KEY=

# OpenBB Financial Data Acquisition & Research Layer
OPENBB_ENABLED=false
OPENBB_FALLBACK_TO_MOCK=true
OPENBB_DEFAULT_EQUITY_PROVIDER=yfinance
OPENBB_DEFAULT_CRYPTO_PROVIDER=yfinance
OPENBB_DEFAULT_FOREX_PROVIDER=yfinance
OPENBB_DEFAULT_MACRO_PROVIDER=fred
OPENBB_TIMEOUT_SECONDS=15.0
OPENBB_CACHE_TTL_SECONDS=300
OPENBB_PAT=
OPENBB_FMP_API_KEY=
OPENBB_POLYGON_API_KEY=
OPENBB_TIINGO_API_KEY=
OPENBB_INTRINIO_API_KEY=
OPENBB_ALPHA_VANTAGE_API_KEY=

# ─────────────────────────────────────────────────────
# BLOCKCHAIN RPCs
# Use Alchemy or Infura — never public RPCs for prod
# ─────────────────────────────────────────────────────
ETHEREUM_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/YOUR_KEY
ETHEREUM_WS_URL=wss://eth-mainnet.alchemyapi.io/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Hot wallet — MAXIMUM 5% of capital, never more
# Use hardware wallet for cold storage
PRIVATE_KEY_HOT_WALLET=0x...       # EVM hot wallet
SOLANA_PRIVATE_KEY=                 # Solana hot wallet (base58)

# Flashbots
FLASHBOTS_AUTH_KEY=0x...            # Separate key for MEV bundles

# ─────────────────────────────────────────────────────
# DATABASE & CACHE
# ─────────────────────────────────────────────────────
POSTGRES_PASSWORD=
DATABASE_URL=
TIMESCALE_URL=postgresql+asyncpg://alghrest:alghrest_secure_pass_2024@localhost:5432/alghrest

REDIS_URL=redis://localhost:6379
REDIS_DB_CACHE=0
REDIS_DB_CELERY=1
REDIS_DB_STATE=2

# ─────────────────────────────────────────────────────
# MESSAGE BUS (Kafka)
# ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_CONSUMER_GROUP_PREFIX=alghrest

# ─────────────────────────────────────────────────────
# VECTOR DATABASE (Semantic Memory)
# ─────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Pinecone (alternative)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# ─────────────────────────────────────────────────────
# SECRETS MANAGEMENT
# ─────────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# ─────────────────────────────────────────────────────
# MONITORING & ALERTING
# ─────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=alghrest_grafana_2024

SENTRY_DSN=https://...@sentry.io/...

# PagerDuty (critical alerts)
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=

# ─────────────────────────────────────────────────────
# TELEGRAM (Signals Bot)
# ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=        # Public signals channel
TELEGRAM_ADMIN_ID=          # Your personal Telegram ID for alerts

# ─────────────────────────────────────────────────────
# AUXILIARY INCOME
# ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...      # Use test key until ready
STRIPE_WEBHOOK_SECRET=whsec_...

# eToro copy trading (API access requires approval)
ETORO_API_KEY=

# ─────────────────────────────────────────────────────
# ML MODELS
# ─────────────────────────────────────────────────────
MODEL_CHECKPOINT_DIR=./artifacts/checkpoints
CNN_MODEL_PATH=./artifacts/checkpoints/cnn_pattern_latest.pt
RL_MODEL_PATH=./artifacts/checkpoints/rl_agent_latest.zip
CUDA_DEVICE=0           # GPU index, -1 for CPU

# Independent manual research service (no broker credentials needed)
ADVISORY_DB_PATH=artifacts/advisory/research.sqlite3
ADVISORY_KAFKA_SERVERS=

# Generate UI and Kafka access keys: python -m scripts.configure_access
API_ACCESS_TOKEN=
ADVISORY_ACCESS_TOKEN=
KAFKA_APP_PASSWORD=
KAFKA_BROKER_PASSWORD=
# Local paper stack uses PLAINTEXT on loopback. Full Compose overrides with SASL.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=

# Shared daily AI reservation limit per environment in one database (UTC).
AI_DAILY_BUDGET_USD=1
AI_DAILY_MAX_CALLS=200
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_PROMPT_BYTES=32768
AI_DECISION_REFRESH_SECONDS=900

# Optional research tap: provision a broker principal with READ only on its five
# intelligence topics and group alghrest.manual-assistant.readonly.v1 first.
# Never reuse the trading principal; default isolated research has no Kafka tap.
ADVISORY_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
ADVISORY_KAFKA_SASL_USERNAME=
ADVISORY_KAFKA_SASL_PASSWORD=
ADVISORY_KAFKA_SSL_CAFILE=
